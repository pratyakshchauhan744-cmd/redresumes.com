generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

generator adminClient {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  output        = "../../admin-panel/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  college_main_faculty
  college_faculty
  student
  candidate
  employer
  admin
  manager
  support
}

enum RemoteType {
  onsite
  hybrid
  remote
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
  freelance
}

enum ExperienceLevel {
  entry
  mid
  senior
  lead
}

enum JobSourceType {
  api
  direct
}

enum ApplicationStatus {
  submitted
  reviewing
  shortlisted
  rejected
  hired
}

enum SignInMethod {
  email_password
  google
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(candidate)
  collegeId     String?
  college       College?       @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  facultyProfile CollegeFaculty? @relation("FacultyUser")
  studentProfile CollegeStudent? @relation("StudentUser")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  phone         String?
  location      String?
  bio           String?
  photoDataUrl  String?
  applications  Application[]
  savedJobs     SavedJob[]
  postedJobs    Job[]          @relation("EmployerJobs")
  companies     Company[]      @relation("EmployerCompany")
  refreshTokens RefreshToken[]
  signInEvents  SignInEvent[]
  resumes       Resume[]
  interviewSessions InterviewSession[]
  subscription  UserSubscription?
  credits       UserCredit?
  transactions  CreditTransaction[]
  adminAuditLogs AdminAuditLog[] @relation("AdminActor")
  signOutEvents  SignOutEvent[]
  createdCollegeCreditTransactions CollegeCreditTransaction[] @relation("CreatedCreditTransactions")
  enterpriseAuditLogs EnterpriseAuditLog[] @relation("EnterpriseAuditActor")
  sentInvitations Invitation[] @relation("SentInvitations")

  @@index([collegeId])
  @@index([role])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  website     String?
  logoUrl     String?
  description String?
  location    String?
  ownerId     String?
  owner       User?    @relation("EmployerCompany", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]

  @@index([name])
}

model Job {
  id             String          @id @default(cuid())
  title          String
  description    String
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedById     String?
  postedBy       User?           @relation("EmployerJobs", fields: [postedById], references: [id], onDelete: SetNull)
  city           String?
  state          String?
  country        String?
  remoteType     RemoteType      @default(onsite)
  employmentType EmploymentType  @default(full_time)
  experienceLevel ExperienceLevel @default(entry)
  salaryMin      Int?
  salaryMax      Int?
  currency       String?         @default("USD")
  sourceType     JobSourceType   @default(direct)
  externalId     String?
  applyUrl       String?
  originalJobUrl String?
  source         String?
  postedAt       DateTime        @default(now())
  dedupeHash     String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  applications   Application[]
  savedByUsers   SavedJob[]

  @@unique([dedupeHash])
  @@index([title])
  @@index([city, state, country])
  @@index([companyId])
  @@index([postedById])
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeUrl String?
  status    ApplicationStatus @default(submitted)
  appliedAt DateTime          @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model SignInEvent {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    SignInMethod
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@index([method])
  @@index([createdAt])
}

model IngestionLog {
  id           String   @id @default(cuid())
  source       String
  fetchedCount Int      @default(0)
  insertedCount Int     @default(0)
  dedupedCount Int      @default(0)
  status       String
  createdAt    DateTime @default(now())
}

model Resume {
  id             String             @id @default(cuid())
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId      String?
  college        College?           @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  fileName       String
  fileUrl        String?            
  parsedData     Json?              
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sessions       InterviewSession[]

  @@index([collegeId])
}

model InterviewSession {
  id             String               @id @default(cuid())
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeId      String?
  college        College?             @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  resumeId       String
  resume         Resume               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  targetRole     String
  companyType    String
  difficulty     String
  interviewStyle String
  durationMins   Int
  jobDescription String?
  interviewerPersona String? @default("HR Recruiter")
  stressMode     Boolean? @default(false)
  status         String               @default("in_progress")
  creditUsed     Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  questions      InterviewQuestion[]
  report         InterviewReport?
  analytics      AnalyticsEvent[]

  @@index([collegeId])
}

model InterviewQuestion {
  id             String               @id @default(cuid())
  sessionId      String
  session        InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText   String
  questionType   String               
  contextRef     String?              
  orderIndex     Int
  createdAt      DateTime             @default(now())
  answer         InterviewAnswer?
}

model InterviewAnswer {
  id             String               @id @default(cuid())
  questionId     String               @unique
  question       InterviewQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText     String
  durationSecs   Int?
  score          Float?
  feedback       Json?                
  createdAt      DateTime             @default(now())
}

model InterviewReport {
  id             String               @id @default(cuid())
  sessionId      String               @unique
  session        InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore   Float
  categoryScores Json
  strengths      String[]
  weaknesses     String[]
  recommendations String[]
  speakingPace   Int?                 
  fillerWords    Int?                 
  voiceConfidence Float?              
  createdAt      DateTime             @default(now())
}

model AnalyticsEvent {
  id             String               @id @default(cuid())
  sessionId      String
  session        InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType      String               
  payload        Json?
  timestamp      DateTime             @default(now())
}

model UserSubscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    
  status               String    
  provider             String    
  subscriptionId       String?   
  currentPeriodStart   DateTime  
  currentPeriodEnd     DateTime  
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model UserCredit {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance              Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model CreditTransaction {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Int?
  balanceAfter      Int?
  type              String?
  source            String?
  referenceId       String?
  packageName       String    @default("Custom Package")
  creditsAdded      Int       @default(0)
  paymentAmount     Int       @default(0)
  razorpayPaymentId String?   @unique
  status            String    @default("completed")
  createdAt         DateTime  @default(now())

  @@index([userId])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  entityType String?
  entityId   String?
  details    Json?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model SignOutEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ===========================================================================
// MULTI-COLLEGE ENTERPRISE SAAS MODELS (PHASE 2 - 6)
// ===========================================================================

model College {
  id                 String                     @id @default(cuid())
  name               String
  universityName     String?
  code               String                     @unique
  officialEmail      String                     @unique
  contactPhone       String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String                     @default("India")
  status             String                     @default("active") // active | inactive | suspended
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  users              User[]
  faculties          CollegeFaculty[]
  students           CollegeStudent[]
  creditAccount      CollegeCreditAccount?
  creditTransactions CollegeCreditTransaction[]
  invitations        Invitation[]
  auditLogs          EnterpriseAuditLog[]
  resumes            Resume[]
  interviewSessions  InterviewSession[]

  @@index([code])
  @@index([status])
}

model CollegeFaculty {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation("FacultyUser", fields: [userId], references: [id], onDelete: Cascade)
  collegeId     String
  college       College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  employeeId    String?
  department    String?
  designation   String?
  isMainFaculty Boolean   @default(false)
  permissions   String[]  @default([])
  programAccess String[]  @default([])
  courseAccess  String[]  @default([])
  sectionAccess String[]  @default([])
  status        String    @default("active") // active | inactive | suspended
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([collegeId])
  @@index([collegeId, status])
}

model CollegeStudent {
  id               String                     @id @default(cuid())
  userId           String                     @unique
  user             User                       @relation("StudentUser", fields: [userId], references: [id], onDelete: Cascade)
  collegeId        String
  college          College                    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  enrollmentNumber String
  program          String
  course           String
  department       String?
  section          String
  batch            String
  academicYear     String?
  semester         Int?
  gender           String?
  dob              DateTime?
  status           String                     @default("active") // active | graduated | inactive
  creditTransactions CollegeCreditTransaction[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([collegeId, enrollmentNumber])
  @@index([collegeId])
  @@index([collegeId, batch])
  @@index([collegeId, program, course, section])
  @@index([collegeId, status])
}

model CollegeCreditAccount {
  id               String   @id @default(cuid())
  collegeId        String   @unique
  college          College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  totalAllocated   Int      @default(0)
  totalDistributed Int      @default(0)
  balance          Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@index([collegeId])
}

model CollegeCreditTransaction {
  id           String          @id @default(cuid())
  collegeId    String
  college      College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  studentId    String?
  student      CollegeStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User            @relation("CreatedCreditTransactions", fields: [createdById], references: [id], onDelete: Cascade)
  type         String          // SUPER_ADMIN_ALLOCATION | FACULTY_DISTRIBUTION | STUDENT_CONSUMPTION | REFUND | ADJUSTMENT
  amount       Int
  balanceAfter Int
  reason       String
  batchFilter  Json?
  createdAt    DateTime        @default(now())

  @@index([collegeId])
  @@index([studentId])
  @@index([createdById])
  @@index([createdAt])
}

model Invitation {
  id          String    @id @default(cuid())
  collegeId   String
  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  email       String
  role        String    // college_main_faculty | college_faculty | student
  tokenHash   String    @unique
  expiresAt   DateTime
  status      String    @default("pending") // pending | accepted | expired | revoked
  metadata    Json?
  invitedById String?
  invitedBy   User?     @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([collegeId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
}

model EnterpriseAuditLog {
  id        String   @id @default(cuid())
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  actorId   String
  actor     User     @relation("EnterpriseAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([collegeId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
